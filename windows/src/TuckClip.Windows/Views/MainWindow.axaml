<Window
    x:Class="TuckClip.Windows.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TuckClip.Windows.Controls"
    xmlns:vm="using:TuckClip.Windows.ViewModels"
    x:DataType="vm:ClipboardPanelViewModel"
    Width="960"
    Height="360"
    MinWidth="640"
    MinHeight="330"
    MaxWidth="1080"
    MaxHeight="480"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Title="TuckClip"
    Topmost="True"
    TransparencyLevelHint="Mica">
  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#12FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
    </Style>
    <Style Selector="Button.filter">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Foreground" Value="#D2FFFFFF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#9BFFFFFF" />
    </Style>
  </Window.Styles>

  <Border
      Margin="18"
      Background="#F10B1026"
      BorderBrush="#20FFFFFF"
      BorderThickness="1"
      CornerRadius="28"
      ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid
          Grid.Row="0"
          Margin="20,17,20,11"
          ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          ColumnSpacing="12">
        <Border
            Grid.ColumnSpan="5"
            Background="Transparent"
            PointerPressed="OnHeaderPointerPressed" />
        <Border
            Grid.Column="0"
            Width="38"
            Height="38"
            Background="#FF5F59F7"
            CornerRadius="11">
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="20"
              FontWeight="Bold"
              Foreground="White"
              Text="⧉" />
        </Border>

        <Border
            Grid.Column="1"
            Height="38"
            Background="#12FFFFFF"
            BorderBrush="#17FFFFFF"
            BorderThickness="1"
            CornerRadius="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="17"
                Foreground="#78FFFFFF"
                Text="⌕" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Padding="0"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="14"
                Foreground="White"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{DynamicResource 搜索内容或来源应用}" />
            <Button
                Grid.Column="2"
                Margin="0,0,6,0"
                Padding="5"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnClearSearchClick"
                Foreground="#80FFFFFF"
                IsVisible="{Binding HasSearch}"
                Content="×"
                ToolTip.Tip="{DynamicResource 清除搜索}" />
          </Grid>
        </Border>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="7">
          <StackPanel
              IsVisible="{Binding HasNoNotice}"
              Orientation="Horizontal"
              Spacing="7">
            <Ellipse
                Width="7"
                Height="7"
                VerticalAlignment="Center"
                Fill="{Binding StatusBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Medium"
                Foreground="#99FFFFFF"
                Text="{Binding StatusText}" />
          </StackPanel>
          <StackPanel
              IsVisible="{Binding HasNotice}"
              Orientation="Horizontal"
              Spacing="6">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{Binding NoticeBrush}"
                Text="{Binding NoticeIcon}" />
            <TextBlock
                MaxWidth="230"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{Binding NoticeBrush}"
                Text="{Binding NoticeText}"
                TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <Button
            Grid.Column="3"
            Classes="chrome"
            Click="OnSettingsClick"
            Content="⚙"
            ToolTip.Tip="{DynamicResource 设置}" />
        <Button
            Grid.Column="4"
            Classes="chrome"
            Click="OnCloseClick"
            Content="×"
            ToolTip.Tip="{DynamicResource 隐藏 TuckClip}" />
      </Grid>

      <StackPanel
          Grid.Row="1"
          Margin="20,0,20,7"
          Orientation="Horizontal"
          Spacing="7">
        <Button Classes="filter" Background="{Binding AllFilterBrush}" Click="OnAllFilterClick"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="▦" /><TextBlock Text="{DynamicResource 全部}" /></StackPanel></Button>
        <Button Classes="filter" Background="{Binding TextFilterBrush}" Click="OnTextFilterClick"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="≡" /><TextBlock Text="{DynamicResource 文本}" /></StackPanel></Button>
        <Button Classes="filter" Background="{Binding LinkFilterBrush}" Click="OnLinkFilterClick"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="↗" /><TextBlock Text="{DynamicResource 链接}" /></StackPanel></Button>
        <Button Classes="filter" Background="{Binding ImageFilterBrush}" Click="OnImageFilterClick"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="▧" /><TextBlock Text="{DynamicResource 图片}" /></StackPanel></Button>
        <Button Classes="filter" Background="{Binding FilesFilterBrush}" Click="OnFilesFilterClick"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="▱" /><TextBlock Text="{DynamicResource 文件}" /></StackPanel></Button>
      </StackPanel>

      <Grid Grid.Row="2" Margin="20,0">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsEmpty}"
            Spacing="7">
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="25"
              Foreground="#FF6A70FF"
              Text="▱" />
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="15"
              FontWeight="SemiBold"
              Foreground="#DEFFFFFF"
              Text="{Binding EmptyTitle}" />
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="11"
              Foreground="#78FFFFFF"
              Text="{Binding EmptyDetail}" />
        </StackPanel>

        <ListBox
            x:Name="CardList"
            Background="Transparent"
            BorderThickness="0"
            IsVisible="{Binding HasItems}"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipCardViewModel">
              <controls:ClipCardControl
                  ActivateRequested="OnCardActivateRequested"
                  DeleteRequested="OnCardDeleteRequested"
                  TogglePinRequested="OnCardTogglePinRequested" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid
          Grid.Row="3"
          Margin="20,7,20,14"
          ColumnDefinitions="Auto,*,Auto">
        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontFamily="Consolas"
            FontSize="10"
            Foreground="#75FFFFFF"
            Text="{Binding ResultCountText}" />
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="#12FFFFFF" CornerRadius="4"><TextBlock Classes="key" Text="↑ ↓" /></Border>
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#75FFFFFF" Text="{DynamicResource 选择}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="#12FFFFFF" CornerRadius="4"><TextBlock Classes="key" Text="Enter" /></Border>
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#75FFFFFF" Text="{DynamicResource 粘贴}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="#12FFFFFF" CornerRadius="4"><TextBlock Classes="key" Text="Ctrl+Enter" /></Border>
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#75FFFFFF" Text="{DynamicResource 纯文本}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="#12FFFFFF" CornerRadius="4"><TextBlock Classes="key" Text="Ctrl+D" /></Border>
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#75FFFFFF" Text="{DynamicResource 置顶}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Background="#12FFFFFF" CornerRadius="4"><TextBlock Classes="key" Text="Shift+Del" /></Border>
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#75FFFFFF" Text="{DynamicResource 删除}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>

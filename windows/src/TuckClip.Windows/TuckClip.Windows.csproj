<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TuckClip.Windows</RootNamespace>
    <AssemblyName>TuckClip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/TuckClip.ico</ApplicationIcon>
    <VersionPrefix>0.1.2</VersionPrefix>
    <Authors>TuckClip contributors</Authors>
    <Description>An offline clipboard history manager.</Description>
    <Copyright>Copyright © 2026 TuckClip contributors</Copyright>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TuckClip.Core/TuckClip.Core.csproj" />
    <ProjectReference Include="../TuckClip.Platform.Windows/TuckClip.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
